{
  "name": "foody-e2e",
  "private": true,
  "description": "Playwright end-to-end tests against the full dev stack (docker-compose.e2e.yml).",
  "type": "module",
  "scripts": {
    "stack:up": "docker compose -f ../docker-compose.yml -f ../docker-compose.e2e.yml up -d --build --wait",
    "stack:down": "docker compose -f ../docker-compose.yml -f ../docker-compose.e2e.yml down",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
